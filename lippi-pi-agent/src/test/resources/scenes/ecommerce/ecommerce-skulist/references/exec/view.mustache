<article class="markdown-body">
<h1>{{title}}</h1>
<p><img data-adam-media-role="hero" alt="主图占位" src=""></p>
<p>{{heroPlan}}</p>
<h2>主图分镜</h2>
<ol>
{{#frameEntries}}
<li><p>{{frame}}</p>{{#prompt}}<p><code>{{prompt}}</code></p>{{/prompt}}</li>
{{/frameEntries}}
</ol>
<h2>详情标题</h2>
<p>{{detailTitle}}</p>
<h2>详情正文</h2>
{{#detailParagraphs}}<p>{{.}}</p>{{/detailParagraphs}}
<h2>展示说明</h2>
<p class="cv-note">{{displayNotes}}</p>
<h2>生图 Prompt</h2>
<ol>
{{#frameEntries}}
<li>{{#prompt}}<p>{{prompt}}</p>{{/prompt}}{{#negative}}<p>negative: {{negative}}</p>{{/negative}}</li>
{{/frameEntries}}
</ol>
</article>
