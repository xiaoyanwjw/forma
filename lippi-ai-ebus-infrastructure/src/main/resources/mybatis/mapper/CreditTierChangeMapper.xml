<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xmut.ebus.infrastructure.persistence.mybatis.mapper.CreditTierChangeMapper">

    <resultMap id="CreditTierChangeResultMap" type="com.xmut.ebus.infrastructure.persistence.mybatis.po.CreditTierChangePO">
        <id property="id" column="id"/>
        <result property="bizId" column="biz_id"/>
        <result property="accountId" column="account_id"/>
        <result property="targetUserId" column="target_user_id"/>
        <result property="operatorUserId" column="operator_user_id"/>
        <result property="fromTier" column="from_tier"/>
        <result property="toTier" column="to_tier"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO ebus_credit_tier_change (
            biz_id, account_id, target_user_id, operator_user_id,
            from_tier, to_tier, created_at
        ) VALUES (
            #{bizId}, #{accountId}, #{targetUserId}, #{operatorUserId},
            #{fromTier}, #{toTier}, #{createdAt}
        )
    </insert>

    <select id="selectByTargetUserId" resultMap="CreditTierChangeResultMap">
        SELECT id, biz_id, account_id, target_user_id, operator_user_id,
               from_tier, to_tier, created_at
        FROM ebus_credit_tier_change
        WHERE target_user_id = #{targetUserId}
        ORDER BY created_at ASC
    </select>
</mapper>
