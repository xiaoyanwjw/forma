<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.xmut.ebus.infrastructure.persistence.mybatis.mapper.UserMapper">

    <resultMap id="UserResultMap" type="com.xmut.ebus.infrastructure.persistence.mybatis.po.UserPO">
        <id property="id" column="id"/>
        <result property="bizId" column="biz_id"/>
        <result property="username" column="username"/>
        <result property="email" column="email"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <sql id="UserColumns">
        id, biz_id, username, email, password_hash, created_at, updated_at
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO ebus_user (biz_id, username, email, password_hash, created_at, updated_at)
        VALUES (#{bizId}, #{username}, #{email}, #{passwordHash}, #{createdAt}, #{updatedAt})
    </insert>

    <update id="updateUsername">
        UPDATE ebus_user
        SET username = #{username},
            updated_at = #{updatedAt}
        WHERE biz_id = #{bizId}
    </update>

    <select id="selectById" resultMap="UserResultMap">
        SELECT <include refid="UserColumns"/>
        FROM ebus_user
        WHERE biz_id = #{id}
    </select>

    <select id="selectByUsername" resultMap="UserResultMap">
        SELECT <include refid="UserColumns"/>
        FROM ebus_user
        WHERE username = #{username}
    </select>

    <select id="selectByEmail" resultMap="UserResultMap">
        SELECT <include refid="UserColumns"/>
        FROM ebus_user
        WHERE email = #{email}
    </select>

    <select id="selectByUsernameOrEmail" resultMap="UserResultMap">
        SELECT <include refid="UserColumns"/>
        FROM ebus_user
        WHERE username = #{account} OR email = #{account}
        LIMIT 1
    </select>
</mapper>
