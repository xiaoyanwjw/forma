{
  "id": "excerpt_chunks",
  "description": "按块摘录原文连续句子，返回对齐摘录，不含各块全文",
  "text": "[excerpt_chunks] 从 text、sourcePath（默认 source.md）或 chunks 摘录。返回 excerpts 与 partialCoverage，禁止返回各块全文。",
  "handlerClass": "com.xmut.forma.extension.tool.tech.ExcerptChunksToolHandler",
  "schema": {
    "name": "excerpt_chunks",
    "description": "旁路摘句：只保留原文子串，非法句子丢掉",
    "parameters": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "description": "直接粘贴的正文；提供则不再读文件"
        },
        "sourcePath": {
          "type": "string",
          "description": "工作区内的正文文件，默认 source.md"
        },
        "chunks": {
          "type": "array",
          "description": "已切好的块；提供则跳过切块",
          "items": {
            "type": "object",
            "properties": {
              "heading": {
                "type": "string",
                "description": "块标题"
              },
              "text": {
                "type": "string",
                "description": "块正文"
              }
            },
            "required": ["text"]
          }
        }
      }
    }
  }
}
