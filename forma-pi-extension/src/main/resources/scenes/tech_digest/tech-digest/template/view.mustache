<article class="markdown-body">
<h1>{{title}}</h1>
<p class="forma-lede">{{oneLiner}}</p>
<p class="forma-disclaimer">AI 摘要，请对照原文。</p>
<h2>要点</h2>
<ul>
{{#points}}<li>{{.}}</li>{{/points}}
</ul>
<h2>原文摘录</h2>
{{#excerpts}}
<h3>{{heading}}</h3>
{{#quotes}}<blockquote>{{.}}</blockquote>{{/quotes}}
{{/excerpts}}
<h2>适合谁</h2>
<p>{{forWhom}}</p>
{{#hasUncertainties}}
<h2>需核实</h2>
<ul>
{{#uncertainties}}<li>{{.}}</li>{{/uncertainties}}
</ul>
{{/hasUncertainties}}
{{#sourceUrl}}<p>原文：<a href="{{sourceUrl}}">{{sourceUrl}}</a></p>{{/sourceUrl}}
</article>
