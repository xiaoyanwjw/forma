# Local / compose environment example — copy to .env (gitignored) and adjust.
# Do NOT commit real secrets.

# MySQL
MYSQL_ROOT_PASSWORD=root123
MYSQL_PORT=3306
DB_NAME=lippi_ebus
DB_USERNAME=ebus
DB_PASSWORD=ebus123

# Starter
STARTER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# If Docker Hub / mirrors fail for eclipse-temurin:8-jre, point to a local Java 8 image:
# STARTER_BASE_IMAGE=lippi-ebus-java8:local
# and build with: DOCKER_BUILDKIT=0 COMPOSE_DOCKER_CLI_BUILD=0

# JWT（HS256，至少 32 字节；勿提交真实生产密钥）
JWT_SECRET=dev-only-change-me-please-32bytes!!
JWT_EXPIRATION_MS=86400000

# 注册/登录 IP 限流（滑动窗口）
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_MS=60000

# 手工改档管理员用户 ID 白名单（逗号分隔 UUID；空则所有改档 403）
# CREDIT_ADMIN_USER_IDS=11111111-1111-1111-1111-111111111111

# Model / OSS keys — leave empty for local stub; set only via env / secrets
# DASHSCOPE_API_KEY=
# DEEPSEEK_API_KEY=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=
