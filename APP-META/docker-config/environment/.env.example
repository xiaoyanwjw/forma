# Local / compose environment example.
# Copy to: APP-META/docker-config/.env  （与 docker-compose.yml 同级，不是本目录）
#   cp APP-META/docker-config/environment/.env.example APP-META/docker-config/environment/.env
# Do NOT commit real secrets.
#
# 应用默认（actor / searcher / rerank 等）在 forma-starter/.../application.yml；
# 本文件只放密钥与运行环境相关项。

# MySQL
MYSQL_ROOT_PASSWORD=root123
MYSQL_PORT=3306
DB_NAME=lippi_ebus
DB_USERNAME=ebus
DB_PASSWORD=ebus123
MYSQL_TZ=Asia/Shanghai
DB_SERVER_TIMEZONE=Asia/Shanghai

# Starter
STARTER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# Hub 拉 JDK 失败时：STARTER_BASE_IMAGE=<本地 Java8 镜像>
# 并：DOCKER_BUILDKIT=0 COMPOSE_DOCKER_CLI_BUILD=0

# JWT（HS256，至少 32 字节）
JWT_SECRET=dev-only-change-me-please-32bytes!!
JWT_EXPIRATION_MS=86400000

# 密钥：空则 Stub；真模型 / 真搜再填（client / actor / searcher 默认见 application.yml）
# DASHSCOPE_API_KEY=
# DEEPSEEK_API_KEY=
# APIFY_TOKEN=
