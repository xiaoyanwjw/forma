# Local / compose environment example.
# Copy to: APP-META/docker-config/.env  （与 docker-compose.yml 同级，不是本目录）
#   cp APP-META/docker-config/environment/.env.example APP-META/docker-config/.env
# Do NOT commit real secrets.

# MySQL
MYSQL_ROOT_PASSWORD=root123
MYSQL_PORT=3306
DB_NAME=lippi_ebus
DB_USERNAME=ebus
DB_PASSWORD=ebus123
# 本地库墙钟时区（compose MySQL TZ + JDBC serverTimezone）；默认北京时间
MYSQL_TZ=Asia/Shanghai
DB_SERVER_TIMEZONE=Asia/Shanghai

# Starter
STARTER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
# If Docker Hub / mirrors fail for eclipse-temurin:8-jre, point to a local Java 8 image:
# STARTER_BASE_IMAGE=lippi-ebus-java8:local
# and build with: DOCKER_BUILDKIT=0 COMPOSE_DOCKER_CLI_BUILD=0

# JWT（HS256，至少 32 字节；勿提交真实生产密钥）
JWT_SECRET=dev-only-change-me-please-32bytes!!
JWT_EXPIRATION_MS=86400000

# 注册/登录 IP 限流（滑动窗口）
# AUTH_RATE_LIMIT_MAX=20
# AUTH_RATE_LIMIT_WINDOW_MS=60000

# 手工改档管理员用户 ID 白名单（逗号分隔 UUID；空则所有改档 403）
# CREDIT_ADMIN_USER_IDS=11111111-1111-1111-1111-111111111111

# Model / OSS keys — leave empty for local stub; set only via env / secrets
# DeepSeek：有 Key 后默认走 deepseek-v4-flash（见 InMemoryModelCatalog）
# DEEPSEEK_API_KEY=sk-你的key
# DASHSCOPE_API_KEY=
# OSS_ACCESS_KEY_ID=
# OSS_ACCESS_KEY_SECRET=

# MinIO（勿提交生产实密）
# IDEA / 本机 spring-boot:run：用 localhost；改完后必须重启应用
# Compose 内 starter：docker-compose.yml 已写死 http://minio:9000
EBUS_MEDIA_STORE=minio
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ebus-media
# 仅测内存桩时可改：
# EBUS_MEDIA_STORE=memory


# SKU search client: mock | apify (default mock)
# EBUS_SKU_SEARCH_CLIENT=mock
# APIFY_TOKEN=
# ebus.sku-search.apify.actor-id=zen-studio/taobao-search-scraper
# Demo pipeline (ebus.sku-search.searcher.*); enabled=false ≈ single port call
# ebus.sku-search.searcher.enabled=true
# ebus.sku-search.searcher.source-page-size=20
# ebus.sku-search.searcher.rerank-pool-size=40
# ebus.sku-search.searcher.rerank-use-case=ebus.sku.rerank
# ebus.sku-search.searcher.rerank-timeout-ms=12000
# ebus.sku-search.searcher.banned-title-keywords=

# XHS note search: mock | apify (default mock)
# EBUS_XHS_NOTE_SEARCH_CLIENT=mock
# ebus.xhs-note-search.apify.actor-id=opspilot.cc/xiaohongshu-keyword-search-scraper
# ebus.xhs-note-search.searcher.enabled=true
# ebus.xhs-note-search.searcher.rerank-pool-size=40
# ebus.xhs-note-search.searcher.rerank-use-case=ebus.xhs.rerank

# EBUS_WORKSPACE_ROOT=   # optional; default ~/.ebus
